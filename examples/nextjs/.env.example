# These env var NAMES are arbitrary — the package takes plain values, not env vars. This example reads
# them in lib/comments.ts and passes them in; name them however you like.

# GitHub OAuth App — https://github.com/settings/developers
GITHUB_COMMENTS_CLIENT_ID=
GITHUB_COMMENTS_CLIENT_SECRET=

# Any long random string (>= 32 chars). Encrypts the OAuth state + the token cookie.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
GITHUB_COMMENTS_TOKEN_SECRET=

# The PUBLIC repo storing the discussions, and its node id (R_...).
GITHUB_COMMENTS_REPO=you/repo
GITHUB_COMMENTS_REPO_ID=

# The Discussions category new threads open in: its NAME and node id (DIC_...).
#   gh api graphql -f query='{ repository(owner:"you", name:"repo"){ id discussionCategories(first:25){nodes{ id name }} } }'
GITHUB_COMMENTS_CATEGORY=Comments
GITHUB_COMMENTS_CATEGORY_ID=

# GitHub login allowed to moderate (delete any comment).
GITHUB_COMMENTS_OWNER_LOGIN=you

# Optional: server token for anonymous reads + opening new threads (classic public_repo PAT).
GITHUB_COMMENTS_READ_TOKEN=
